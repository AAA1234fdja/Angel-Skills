{
  "$schema": "angel/jsonschema-subset",
  "$id": "workflow/contracts/skill-report@1.1.0",
  "title": "Skill report",
  "description": "What a skill reports when it has finished: verdict, evidence and the next action. Produced by any skill tool, consumed by wev-verdict and the journal.",
  "type": "object",
  "x-consumers": [
    "wev",
    "ely",
    "journal"
  ],
  "required": [
    "skill",
    "verdict",
    "criteria"
  ],
  "additionalProperties": false,
  "properties": {
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "skill_version": {
      "type": "integer",
      "minimum": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "met"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "maxLength": 240
          },
          "met": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "message"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 400
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "next_action": {
      "type": "string",
      "maxLength": 240
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
