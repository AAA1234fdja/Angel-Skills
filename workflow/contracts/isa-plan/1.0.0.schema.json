{
  "$schema": "angel/jsonschema-subset",
  "$id": "workflow/contracts/isa-plan@1.0.0",
  "title": "ISA plan payload",
  "description": "The body of an isa-plan message once the envelope is stripped: what is to be achieved, in which steps, within which budget.",
  "type": "object",
  "x-consumers": [
    "yev",
    "ely"
  ],
  "required": [
    "objective",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8,
      "maxLength": 400
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "skills"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "phase": {
            "type": "string",
            "enum": [
              "plan",
              "design",
              "research",
              "implement",
              "test",
              "review",
              "verify",
              "debug",
              "audit",
              "document",
              "meta"
            ]
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "string",
            "maxLength": 300
          },
          "verb": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "statement"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "statement": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "expect": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  }
}
