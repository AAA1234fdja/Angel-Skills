{
  "id": "angel.workflow",
  "name": "Angel Workflow",
  "version": "0.5.0",
  "publisher": "angel",
  "description": "Paquete de skills Angel: listar por categoría, cargar una fase en el chat, abrir una skill con sus herramientas, recorrer el árbol de agentes y validar el paquete antes de guardar.",
  "main": "main.js",
  "permissions": [
    "workspace:read",
    "ui",
    "commands",
    "chat"
  ],
  "activationEvents": [
    "onStartup"
  ],
  "engines": {
    "ely": ">=0.9"
  },
  "contributes": {
    "commands": [
      {
        "id": "angel.workflow.list",
        "title": "Workflow: listar skills"
      },
      {
        "id": "angel.workflow.phase",
        "title": "Workflow: cargar fase en el chat"
      },
      {
        "id": "angel.workflow.skill",
        "title": "Workflow: abrir una skill"
      },
      {
        "id": "angel.workflow.validate",
        "title": "Workflow: validar el paquete"
      },
      {
        "id": "angel.workflow.standard",
        "title": "Workflow: leer el estándar"
      },
      {
        "id": "angel.workflow.tools",
        "title": "Workflow: ver herramientas de una skill"
      },
      {
        "id": "angel.workflow.agents",
        "title": "Workflow: agentes del paquete"
      },
      {
        "id": "angel.workflow.agenttree",
        "title": "Workflow: árbol de agentes"
      },
      {
        "id": "angel.workflow.agentaddress",
        "title": "Workflow: dirección de un agente"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Angel Workflow",
      "description": "Angel skill pack: list by category, load a phase into the chat, open a skill with its tools, walk the agent tree, and validate the pack before saving."
    }
  }
}
