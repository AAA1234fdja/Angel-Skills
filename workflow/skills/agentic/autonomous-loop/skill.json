{
  "id": "autonomous-loop",
  "category": "agentic",
  "description": "Run unattended loops safely: explicit stop conditions, budgets, checkpoints and human gates. Use when a task should repeat without supervision, or when an existing loop keeps running past its usefulness.",
  "phase": "implement",
  "verbs": [
    "implement",
    "design"
  ],
  "triggers": [
    "run unattended",
    "unattended loop",
    "keep going until",
    "run overnight",
    "loop until green"
  ],
  "keywords": [
    "loop",
    "autonomous",
    "stop",
    "budget",
    "checkpoint"
  ],
  "tools": [
    {
      "id": "loop-guard",
      "entry": "tools/loop_guard.py",
      "risk": "read",
      "timeout": 10,
      "description": "Validates a loop definition has the required guards before it runs.",
      "input": {
        "type": "object",
        "properties": {
          "loop": {
            "type": "object"
          }
        },
        "required": [
          "loop"
        ]
      },
      "sample": {
        "loop": {
          "success_test": "npm test",
          "max_iterations": 10,
          "max_seconds": 3600,
          "max_cost": 5.0,
          "no_progress_after": 3,
          "checkpoint": "git commit",
          "gates": [
            "deploy"
          ],
          "failure_policy": "revert the iteration on failure"
        }
      }
    }
  ],
  "contracts": [],
  "requires": [],
  "routing": {
    "not_for": []
  },
  "acceptance": [
    {
      "id": "exit",
      "statement": "the skill's exit criteria are met",
      "kind": "review"
    }
  ]
}
